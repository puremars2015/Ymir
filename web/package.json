{
  "name": "ymir-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "api:generate": "npx -y -p typescript@5.9 -p openapi-typescript@7.13.0 openapi-typescript ../src/Ymir.Api/openapi/v1.json -o src/app/core/api/schema.ts && prettier --write src/app/core/api/schema.ts",
    "e2e": "node e2e/chat-flow.mjs",
    "e2e:auth": "node e2e/auth-flow.mjs",
    "e2e:make": "node e2e/make-flow.mjs",
    "e2e:admin": "node e2e/admin-flow.mjs",
    "e2e:attach": "node e2e/attachment-flow.mjs"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "marked": "^18.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "angular-eslint": "22.5.0",
    "eslint": "^10.9.1",
    "jsdom": "^30.0.0",
    "playwright": "^1.63.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.69.0",
    "vitest": "^5.0.0"
  }
}
