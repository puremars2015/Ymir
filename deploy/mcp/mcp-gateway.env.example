# 複製到 /etc/ymir/mcp-gateway.env（chmod 600，擁有者 root）。不得提交到版控。
# 與 API 共用的 token 簽章金鑰（至少 32 字元）：openssl rand -hex 32
# API 端設定 Ymir__Mcp__TokenSigningKey 為同一個值（deploy/api/.env）。
McpGateway__TokenSigningKey=<openssl rand -hex 32>
McpGateway__CatalogPath=/opt/ymir/mcp/servers.json
McpGateway__RequestsPerMinute=60
McpGateway__BackendTimeoutSeconds=120

# 內建的 OneDrive 外掛（ADR-0030）：gateway 連得到的 Ymir API 位址；/mcp/onedrive 會轉送到 {ApiUrl}/internal/mcp/onedrive。
# 不設定時 Agent 無法使用 OneDrive 外掛（同步資料夾不受影響）。後端憑證由簽章金鑰衍生，不需要另一個 secret。
McpGateway__ApiUrl=http://127.0.0.1:8080

# 只寫稽核（platform.audit_log）；建議用只對 platform schema 有寫入權限的資料庫帳號。
ConnectionStrings__ymir=Server=127.0.0.1,1433;Database=ymir;User Id=ymir_mcp_gateway;Password=<secret>;TrustServerCertificate=True

# Gateway 監聽位址：Agent container 所在的網路（含受限網路）必須連得到。
ASPNETCORE_URLS=http://0.0.0.0:5310

# 各平台服務的後端憑證（servers.json 的 credentialEnv），只存在這裡，不進 Agent container 或版控。
# YMIR_MCP_ECHO_TOKEN=<secret>
