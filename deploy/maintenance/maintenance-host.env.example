# 複製到 /etc/ymir/maintenance-host.env（chmod 600，擁有者 root）。不得提交到版控。
# 與 API 共用的 token（至少 32 字元）：openssl rand -hex 32
MaintenanceHost__Token=<與 deploy/api/.env 的 Ymir__Maintenance__Token 相同>
MaintenanceHost__Listen=unix:/run/ymir-maintenance/maintenance.sock
MaintenanceHost__SocketMode=660
MaintenanceHost__StateDirectory=/var/lib/ymir-maintenance
# 與 runtime host 的 VibeMaker__Runtime__LifecycleLockDirectory 相同；沒有設定或目錄不存在時只監控與 dry run，不會自動刪除。
MaintenanceHost__LockDirectory=/run/ymir-lifecycle

# 時間參數（管理介面只顯示，不可修改）
MaintenanceHost__SampleIntervalSeconds=30
MaintenanceHost__SustainMinutes=5
MaintenanceHost__CooldownMinutes=10
MaintenanceHost__RecoveryMarginPercent=5
MaintenanceHost__MaxDeletionsPerRound=10
MaintenanceHost__KeepRecentVersions=3
MaintenanceHost__RetentionSweepMinutes=60

# Store 0：root（rootful Podman）：正式 API、入口 nginx、Tunnel。
MaintenanceHost__Stores__0__Name=root
MaintenanceHost__Stores__0__Account=root
MaintenanceHost__Stores__0__ImageRepositories__0=localhost/ymir/api
MaintenanceHost__Stores__0__ServiceContainers__0=ymir-api
MaintenanceHost__Stores__0__ServiceContainers__1=ymir-web
MaintenanceHost__Stores__0__ServiceContainers__2=ymir-cloudflared
MaintenanceHost__Stores__0__PinnedImageSources__0__File=/etc/containers/systemd/ymir-api.container
MaintenanceHost__Stores__0__PinnedImageSources__0__Key=Image

# Store 1：ymir（rootless）：每位使用者的 Agent runtime、LiteLLM proxy。
MaintenanceHost__Stores__1__Name=ymir
MaintenanceHost__Stores__1__Account=ymir
MaintenanceHost__Stores__1__ImageRepositories__0=localhost/ymir/agent-runtime
MaintenanceHost__Stores__1__ServiceContainers__0=ymir-litellm-proxy
MaintenanceHost__Stores__1__AgentContainers=true
MaintenanceHost__Stores__1__AgentWorkspaceRoot=/srv/ymir/workspaces
MaintenanceHost__Stores__1__PinnedImageSources__0__File=/etc/ymir/runtime-host.env
MaintenanceHost__Stores__1__PinnedImageSources__0__Key=VibeMaker__Runtime__Image

# Store 2：itadmin（rootless，與其他專案共用）：只看 Ymir 的 repository；歸屬不明的 dangling 一律略過。
MaintenanceHost__Stores__2__Name=itadmin
MaintenanceHost__Stores__2__Account=itadmin
MaintenanceHost__Stores__2__ImageRepositories__0=localhost/ymir/api
MaintenanceHost__Stores__2__ImageRepositories__1=localhost/ymir/agent-runtime
MaintenanceHost__Stores__2__ServiceContainers__0=ymir-sql
MaintenanceHost__Stores__2__ServiceContainers__1=ymir-sql-old

# 永不回收的 container（例如保留的舊資料庫容器）。
MaintenanceHost__ExcludedContainers__0=ymir-sql-old

# 部署盤點登記：加上 ymir.managed label 之前建置、確認屬於 Ymir 的既有 image（至少 12 碼 image ID）。
# MaintenanceHost__RegisteredImages__0=<image id>
# 明確保護的回復版本（image ID）。
# MaintenanceHost__ProtectedImages__0=<image id>
