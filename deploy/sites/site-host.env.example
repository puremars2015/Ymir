# 複製到 /etc/ymir/site-host.env（chmod 600，擁有者 root）。不得提交到版控。
# 與 API 的 Ymir__Sites__BaseUrl 相同：網站網址為 <8 碼代碼>.<host>
SiteHost__BaseUrl=https://sites.example.com
# 網站 volume（API 寫入；這裡唯讀）
SiteHost__Root=/srv/ymir/sites
# Ymir 前端網址：私人網站登入時導向 <PlatformUrl>/site-access（ADR-0016 §4）
SiteHost__PlatformUrl=https://ymir.example.com
# 網站 cookie 的 Data Protection 金鑰（與 API 分開，SiteHost 可寫）
SiteHost__DataProtectionKeysPath=/var/lib/ymir-site-host/keys
# 只查網站、分享、使用者狀態與兌換票據；建議用權限最小的資料庫帳號
ConnectionStrings__ymir=Server=127.0.0.1,1433;Database=ymir;User Id=ymir_site_host;Password=<secret>;TrustServerCertificate=True
# 只綁本機，由 cloudflared 的 *.sites.example.com 路由轉進來
ASPNETCORE_URLS=http://127.0.0.1:5300
