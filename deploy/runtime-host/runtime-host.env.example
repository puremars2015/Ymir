# 複製到 /etc/ymir/runtime-host.env（chmod 600，擁有者 root）。不得提交到版控。
# 與 API 共用的 token（至少 32 字元）：openssl rand -hex 32
RuntimeHost__Token=<與 deploy/api/.env 的 VibeMaker__Runtime__Remote__Token 相同>
RuntimeHost__Listen=unix:/run/ymir-runtime/runtime.sock
RuntimeHost__SocketMode=660

# Rootless Podman 需要使用者的 runtime 目錄：/run/user/<ymir 的 uid>（id -u ymir）
XDG_RUNTIME_DIR=/run/user/<uid>

# Agent runtime 設定（與原本 API 的 VibeMaker:Runtime 相同，ADR-0005 / ADR-0007）
VibeMaker__Runtime__Provider=Podman
VibeMaker__Runtime__WorkspaceRoot=/srv/ymir/workspaces
VibeMaker__Runtime__Image=localhost/ymir/agent-runtime:1.0.0
VibeMaker__Runtime__MemoryLimit=2g
VibeMaker__Runtime__CpuLimit=1.0
# SELinux 主機（Fedora / RHEL）設為 true
VibeMaker__Runtime__SelinuxRelabel=false

# Cloudflare Tunnel 由管理介面設定（ADR-0010）：token 寫入 ~ymir/.config/ymir/cloudflared.env（600），
# 並以 systemctl --user 重啟 ymir-cloudflared.service（deploy/cloudflared/ymir-cloudflared.container）。
# 不使用這個功能（例如 Windows 開發機）時設為 Disabled 或移除。
RuntimeHost__Tunnel__Mode=SystemdUser
# RuntimeHost__Tunnel__EnvFile=/home/ymir/.config/ymir/cloudflared.env
# RuntimeHost__Tunnel__Unit=ymir-cloudflared.service
