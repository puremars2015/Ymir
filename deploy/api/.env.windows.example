# Windows + Docker Desktop 開發用；複製成 .env.windows 後填入（已被 .gitignore 排除，不得提交）。
# 開發 / 驗證用 Development（有免密碼的 dev 登入、啟動時自動 migrate），不可對外公開（ADR-0006）。
ASPNETCORE_ENVIRONMENT=Development

# 容器內連 Windows 主機上的 SQL Server（docs/guides/windows-docker.md 第 1 節）
ConnectionStrings__ymir=Server=host.docker.internal,1433;Database=ymir;User Id=sa;Password=Ymir_Dev_Passw0rd!;TrustServerCertificate=True

# 與 Windows 上 runtime host 的 RuntimeHost__Token 相同（至少 32 字元）
VibeMaker__Runtime__Remote__Token=<與 runtime host 相同的值>

# 真正的 Pi + Fake LLM（Agent container 經 host.docker.internal 連到主機上的 Fake LLM）
VibeMaker__Harness=Pi
VibeMaker__Pi__ModelBaseUrl=http://host.docker.internal:5199/v1
VibeMaker__Pi__ModelId=fake-model
VibeMaker__Pi__DevelopmentApiKey=dev-key

# （選用）用你們的 Entra 登入；Entra 的重新導向 URI 需包含 http://localhost:5080/signin-oidc（docs/guides/entra-id.md）
#Ymir__Auth__Oidc__Authority=https://login.microsoftonline.com/e333846a-0ee2-4e2d-a13b-efc97851b892/v2.0
#Ymir__Auth__Oidc__ClientId=5e85a804-c308-4402-b621-0be6d023a2ac
#Ymir__Auth__Oidc__ClientSecret=<用戶端密碼>
