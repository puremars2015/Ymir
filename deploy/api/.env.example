# 複製成同目錄的 .env 後填入（.env 已被 .gitignore 排除，不得提交）。
# ymir-runtime group 的 gid：getent group ymir-runtime | cut -d: -f3
YMIR_RUNTIME_GID=<gid>
# Data Protection 金鑰目錄的上層（會掛載 <此目錄>/keys，需先建立：sudo install -d -o 1654 -g 1654 -m 700 /srv/ymir/api/keys）
YMIR_API_DATA=/srv/ymir/api

ConnectionStrings__ymir=Server=127.0.0.1,1433;Database=ymir;User Id=<user>;Password=<password>;TrustServerCertificate=True

# 與 runtime host 的 RuntimeHost__Token 相同（/etc/ymir/runtime-host.env）
VibeMaker__Runtime__Remote__Token=<openssl rand -hex 32 產生的值>

# LiteLLM（ADR-0004）：API 用 master key 為每位使用者發 virtual key；master key 不會進 Agent container
VibeMaker__LiteLlm__BaseUrl=http://127.0.0.1:4000
VibeMaker__LiteLlm__MasterKey=<與 deploy/litellm/.env 的 LITELLM_MASTER_KEY 相同>
# Agent container 內連 LiteLLM 的位址（rootless Podman）
VibeMaker__Pi__ModelBaseUrl=http://host.containers.internal:4000/v1
VibeMaker__Pi__ModelId=minimax
VibeMaker__Models__0__Id=minimax
VibeMaker__Models__0__DisplayName=MiniMax M2

# 可調整思考的模型依實際路由配置；MiniMax M2.7 不配置 Thinking。
# OpenRouter 經 LiteLLM 使用 reasoning.effort，Levels 必須是該模型實際接受的值。
# VibeMaker__Models__1__Thinking__Parameter=reasoning.effort
# VibeMaker__Models__1__Thinking__Levels__0=low
# VibeMaker__Models__1__Thinking__Levels__1=medium
# VibeMaker__Models__1__Thinking__Levels__2=high
# VibeMaker__Models__1__Thinking__Levels__3=xhigh
# VibeMaker__Models__1__Thinking__Levels__4=max
# VibeMaker__Models__1__Thinking__DefaultLevel=medium
# VibeMaker__Models__1__Thinking__Required=true

# 對外入口（ADR-0006）；不對外時刪除這兩行
Ymir__PublicEdge__Enabled=true
Ymir__PublicEdge__PublicHostname=ymir.thetainformation.com

# 企業帳號登入（Entra ID，ADR-0009；步驟見 docs/guides/entra-id.md）
Ymir__Auth__Oidc__Authority=https://login.microsoftonline.com/e333846a-0ee2-4e2d-a13b-efc97851b892/v2.0
Ymir__Auth__Oidc__ClientId=5e85a804-c308-4402-b621-0be6d023a2ac
# Entra「憑證及祕密」產生的用戶端密碼「值」；只放在這裡，不得提交
Ymir__Auth__Oidc__ClientSecret=<用戶端密碼>
# 本機帳號密碼登入（給沒有公司帳號的人；帳號由 Admin 建立）。只用企業帳號時設為 false
Ymir__Auth__LocalAccounts__Enabled=true

# 資料保存期限（天，0 表示永久保留）：稽核紀錄、已結束 execution 的事件。對話與檔案永久保留。見 docs/guides/backup-restore.md
# Ymir__Retention__AuditLogDays=365
# Ymir__Retention__ExecutionEventDays=90

# 監控指標與 trace（SA §18）：設定 OTLP collector 後匯出 ymir.* 指標（active / busy runtimes、execution duration、failures）
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317
