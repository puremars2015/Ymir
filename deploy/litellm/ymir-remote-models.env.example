# 外部 LiteLLM（llm.webpromaterial.com）的 API 設定範本（ADR-0004 補充）：模型呼叫走 llm，LiteLLM 管理走 llm-admin（Cloudflare Access）。
# 完整替換 API 環境檔中的 Models／AllowedModels／Pi ModelId 與 LiteLLM 連線設定，不要疊加到舊索引；
# 這份不適用 apply-linux-models.sh（那支腳本只管本機 LiteLLM 與六個舊模型）。
# 模型 Id 必須與 https://llm.webpromaterial.com/v1/models 的 id 相同；能力依 2026-10-28 遠端 /v1/model/info 與實測。

# 模型呼叫：Agent（Pi）與知識庫都直接打 llm，用每人的 virtual key
VibeMaker__Pi__ModelBaseUrl=https://llm.webpromaterial.com/v1
VibeMaker__Rag__BaseUrl=https://llm.webpromaterial.com

# LiteLLM 管理（發 key、使用者與預算、用量、health）：llm-admin 在 Cloudflare Access 後面，必須 https
VibeMaker__LiteLlm__BaseUrl=https://llm-admin.webpromaterial.com
VibeMaker__LiteLlm__MasterKey=<遠端 LiteLLM 的 admin key（master key 或 proxy_admin，不設 allowed_routes）>
VibeMaker__LiteLlm__CfAccessClientId=<Cloudflare Access service token 的用戶端識別碼>
VibeMaker__LiteLlm__CfAccessClientSecret=<Cloudflare Access service token 的用戶端密碼>

# Provider 是模型的上游（遠端 LiteLLM 的 litellm_params.model），只顯示在管理介面（ADR-0020 補充）。
# Thinking 只為已驗證 effort 值的模型設定（Claude Sonnet / Haiku 沿用 OpenRouter 官方目錄的值）；
# 其他模型的 effort 值尚未核對，先不提供思考深度，不得冒充。
VibeMaker__Pi__ModelId=claude-sonnet-5.5
VibeMaker__Models__0__Id=claude-sonnet-5.5
VibeMaker__Models__0__DisplayName=Claude Sonnet 5.5
VibeMaker__Models__0__Provider=OpenRouter
VibeMaker__Models__0__SupportsImages=true
VibeMaker__Models__0__Thinking__Parameter=reasoning.effort
VibeMaker__Models__0__Thinking__Levels__0=low
VibeMaker__Models__0__Thinking__Levels__1=medium
VibeMaker__Models__0__Thinking__Levels__2=high
VibeMaker__Models__0__Thinking__Levels__3=xhigh
VibeMaker__Models__0__Thinking__Levels__4=max
VibeMaker__Models__0__Thinking__DefaultLevel=high
VibeMaker__Models__0__Thinking__Required=true
VibeMaker__Models__1__Id=claude-opus-5.5
VibeMaker__Models__1__DisplayName=Claude Opus 5.5
VibeMaker__Models__1__Provider=OpenRouter
VibeMaker__Models__1__SupportsImages=true
VibeMaker__Models__1__SupportsThinking=false
