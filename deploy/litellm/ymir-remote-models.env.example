VibeMaker__Models__2__Thinking__Levels__4=max
VibeMaker__Models__2__Thinking__DefaultLevel=medium
VibeMaker__Models__2__Thinking__Required=false
VibeMaker__Models__3__Id=gpt-6.1-sol
