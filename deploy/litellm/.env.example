# 複製成同目錄的 .env 後填入（.env 已被 .gitignore 排除，不得提交）。
MINIMAX_API_KEY=<MiniMax 國際站的 API key>
# 選用 OpenRouter 時填入；未填入前不要在 Ymir 模型選單啟用 OpenRouter 模型。
OPENROUTER_API_KEY=
# 呼叫 LiteLLM 管理 API 的金鑰（Ymir API 用來發 virtual key），自行產生：echo "sk-$(openssl rand -hex 24)"
LITELLM_MASTER_KEY=sk-<隨機值>
# 加密資料庫內金鑰用，設定後不可更改：openssl rand -hex 32
LITELLM_SALT_KEY=<隨機值>
# LiteLLM 專用 PostgreSQL 的密碼：openssl rand -hex 16
LITELLM_DB_PASSWORD=<隨機值>
# Fake LLM（開發用）；container 內連 host 用 host.docker.internal
FAKE_LLM_BASE=http://host.docker.internal:5199/v1
