{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "VibeMaker": {
    "Harness": "Pi",
    "Runtime": {
      "Provider": "Podman",
      "Image": "localhost/ymir/agent-runtime:dev",
      "MemoryLimit": "2g",
      "CpuLimit": "1.0",
      "PidsLimit": 512,
      "SelinuxRelabel": false,
      "IdleTimeoutMinutes": 30,
      "ExecutionTimeoutMinutes": 30
    },
    "Pi": {
      "Executable": "pi",
      "ProviderName": "ymir",
      "ModelBaseUrl": "http://host.containers.internal:4000/v1",
      "ModelId": "default",
      "AutoRetry": true
    }
  }
}
