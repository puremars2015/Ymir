    "/api/executions/{executionId}/events": {
      "get": {
        "tags": [
          "Executions"
        ],
        "summary": "SSE：execution 即時事件。支援 Last-Event-ID 斷線續傳。",
        "operationId": "StreamExecutionEvents",
        "parameters": [
          {
            "name": "executionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "lastEventId",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
