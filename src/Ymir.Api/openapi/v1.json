    "/api/executions/{executionId}/events": {
      "get": {
        "tags": [
          "Executions"
        ],
        "summary": "SSE：execution 即時事件。支援 Last-Event-ID 斷線續傳。",
        "operationId": "StreamExecutionEvents",
        "parameters": [
          {
            "name": "executionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "lastEventId",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/executions/{executionId}/cancel": {
      "post": {
        "tags": [
          "Executions"
        ],
        "operationId": "CancelExecution",
        "parameters": [
          {
            "name": "executionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CancelExecutionResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CancelExecutionResponse": {
        "required": [
          "executionId",
          "status"
        ],
        "type": "object",
        "properties": {
          "executionId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "ConversationResponse": {
        "required": [
          "id",
          "workspaceId",
          "title",
          "status",
          "createdAt",
          "updatedAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "workspaceId": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CreateConversationRequest": {
        "required": [
          "workspaceId",
          "title"
        ],
        "type": "object",
        "properties": {
          "workspaceId": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          }
        }
      },
      "CreateWorkspaceRequest": {
        "required": [
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        }
      },
      "DevLoginRequest": {
        "required": [
          "account",
          "displayName",
          "role"
        ],
        "type": "object",
        "properties": {
          "account": {
            "type": [
              "null",
              "string"
            ]
          },
          "displayName": {
            "type": [
              "null",
              "string"
            ]
          },
          "role": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/UserRole"
              }
            ]
          }
        }
      },
      "MeResponse": {
        "required": [
          "id",
          "displayName",
          "accountName",
          "email",
          "department",
          "role",
          "status"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "displayName": {
            "type": "string"
          },
          "accountName": {
            "type": [
              "null",
              "string"
            ]
          },
          "email": {
            "type": [
              "null",
              "string"
            ]
          },
          "department": {
            "type": [
              "null",
              "string"
            ]
          },
          "role": {
            "$ref": "#/components/schemas/UserRole"
          },
          "status": {
            "$ref": "#/components/schemas/UserStatus"
          }
        }
      },
      "MessageResponse": {
        "required": [
          "id",
          "role",
          "messageType",
          "content",
          "sequenceNo",
          "executionId",
          "createdAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "type": "string"
          },
          "messageType": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "sequenceNo": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "executionId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "RuntimeStatusResponse": {
        "required": [
          "workspaceId",
          "status",
          "provider",
          "imageVersion",
          "lastActiveAt"
        ],
        "type": "object",
        "properties": {
          "workspaceId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string"
          },
          "provider": {
            "type": [
              "null",
              "string"
            ]
          },
          "imageVersion": {
            "type": [
              "null",
              "string"
            ]
          },
          "lastActiveAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        }
      },
      "SendMessageRequest": {
        "required": [
          "content",
          "clientRequestId"
        ],
        "type": "object",
        "properties": {
          "content": {
            "type": "string"
          },
          "clientRequestId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "SendMessageResponse": {
        "required": [
          "messageId",
          "executionId",
          "eventStreamUrl"
        ],
        "type": "object",
        "properties": {
          "messageId": {
            "type": "string",
            "format": "uuid"
          },
          "executionId": {
            "type": "string",
            "format": "uuid"
          },
          "eventStreamUrl": {
            "type": "string"
          }
        }
      },
      "UserRole": {
        "enum": [
          "User",
          "Admin"
        ]
      },
      "UserStatus": {
        "enum": [
          "Active",
          "Disabled"
        ]
      },
      "WorkspaceResponse": {
        "required": [
          "id",
          "name",
          "status",
          "createdAt",
          "updatedAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Auth"
    },
    {
      "name": "Conversations"
    },
    {
      "name": "Workspaces"
    },
    {
      "name": "Executions"
    }
  ]
}
