{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MaintenanceHost": {
    "Listen": "unix:/run/ymir-maintenance/maintenance.sock",
    "SocketMode": "660",
    "StateDirectory": "/var/lib/ymir-maintenance",
    "LockDirectory": "/run/ymir-lifecycle"
  }
}
