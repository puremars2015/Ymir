# Ymir / Vibe Maker Agent Runtime image（SA §7、ADR-0003）
#
#   podman build -t localhost/ymir/agent-runtime:dev -f runtime/agent/Containerfile runtime/agent
#
# 一個使用者一個長駐 container（ADR-0007、ADR-0033），API 以 `podman exec -i` 啟動 `pi --mode rpc`。
# 主程序是 ymir-runtime-init（ADR-0034）：container 每次啟動時恢復使用者登記的常駐程序與排程。
FROM docker.io/library/node:24-bookworm-slim

# 主機維護服務只把有這個 label 的 image 視為 Ymir 的（ADR-0025 §2）。
LABEL ymir.managed="true"

# Pi 版本鎖定；升級時需同步更新 tests/Ymir.UnitTests/Fixtures/pi-rpc 並重跑整合測試。
ARG PI_VERSION=1.0.0

RUN apt-get update \
 && apt-get install -y --no-install-recommends bash ca-certificates curl git python3 python3-venv ripgrep poppler-utils fonts-noto-cjk \
 && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/ymir/python \
 && /opt/ymir/python/bin/pip install --no-cache-dir python-pptx==1.0.2 lxml==5.3.2
ENV PATH="/opt/ymir/python/bin:${PATH}"

RUN npm install -g --ignore-scripts "@earendil-works/pi-coding-agent@${PI_VERSION}" \
 && npm cache clean --force

# 排程工具 supercronic（ADR-0034）：非 root 執行使用者的 /workspace/.ymir/crontab。版本與 sha256 鎖定，
# 升級時重新下載官方 release 並更新雜湊（SHA-1 可與 supercronic README 公布值核對）。
ARG SUPERCRONIC_VERSION=v0.2.33
ARG TARGETARCH
RUN set -eu; \
    arch="${TARGETARCH:-$(dpkg --print-architecture)}"; \
    case "$arch" in \
      amd64) sha=feefa310da569c81b99e1027b86b27b51e6ee9ab647747b49099645120cfc671 ;; \
      arm64) sha=f1f8585c66de020fef494dd636058f99949d108f569fef00016a1c8b9eb145b3 ;; \
      *) echo "unsupported architecture: $arch" >&2; exit 1 ;; \
    esac; \
    mkdir -p /opt/ymir/bin; \
    curl -fsSL -o /opt/ymir/bin/supercronic "https://github.com/aptible/supercronic/releases/download/${SUPERCRONIC_VERSION}/supercronic-linux-${arch}"; \
    echo "$sha  /opt/ymir/bin/supercronic" | sha256sum -c -; \
    chmod 0755 /opt/ymir/bin/supercronic

# 背景工作的啟動程式與模型 key 輔助指令（ADR-0034）；唯讀，不在使用者 workspace。
COPY --chmod=0755 scripts/ymir-runtime-init scripts/ymir-env /opt/ymir/bin/
ENV PATH="/opt/ymir/bin:${PATH}"

# 平台模板唯讀，不放在使用者 workspace，避免被誤列為成果或遭修改。
COPY templates/ /opt/ymir/templates/

# node image 內建 uid/gid 1000 的 node 使用者，改名為 agent。
# Rootless Podman 以 --userns keep-id:uid=1000,gid=1000 讓 host 使用者對應到 agent，掛載目錄的權限才會正確。
RUN groupmod -n agent node \
 && usermod -l agent -d /home/agent -m node \
 && mkdir -p /workspace /agent-state \
 && chown agent:agent /workspace /agent-state

ENV HOME=/home/agent \
    PYTHONDONTWRITEBYTECODE=1 \
    PI_OFFLINE=1 \
    PI_SKIP_VERSION_CHECK=1 \
    PI_TELEMETRY=0 \
    PI_CODING_AGENT_DIR=/agent-state/pi-agent \
    NPM_CONFIG_CACHE=/tmp/.npm \
    NPM_CONFIG_UPDATE_NOTIFIER=false

USER agent
WORKDIR /workspace
CMD ["/opt/ymir/bin/ymir-runtime-init"]
