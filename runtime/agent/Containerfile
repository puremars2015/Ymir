# Ymir / Vibe Maker Agent Runtime image（SA §7、ADR-0003）
#
#   podman build -t localhost/ymir/agent-runtime:dev -f runtime/agent/Containerfile runtime/agent
#
# 一個 workspace 一個長駐 container（CMD sleep infinity），API 以 `podman exec -i` 啟動 `pi --mode rpc`。
FROM docker.io/library/node:24-bookworm-slim

# Pi 版本鎖定；升級時需同步更新 tests/Ymir.UnitTests/Fixtures/pi-rpc 並重跑整合測試。
ARG PI_VERSION=1.0.0

RUN apt-get update \
 && apt-get install -y --no-install-recommends bash ca-certificates curl git python3 ripgrep \
 && rm -rf /var/lib/apt/lists/*

RUN npm install -g --ignore-scripts "@earendil-works/pi-coding-agent@${PI_VERSION}" \
 && npm cache clean --force

# node image 內建 uid/gid 1000 的 node 使用者，改名為 agent。
# Rootless Podman 以 --userns keep-id:uid=1000,gid=1000 讓 host 使用者對應到 agent，掛載目錄的權限才會正確。
RUN groupmod -n agent node \
 && usermod -l agent -d /home/agent -m node \
 && mkdir -p /workspace /agent-state \
 && chown agent:agent /workspace /agent-state

ENV HOME=/home/agent \
    PI_OFFLINE=1 \
    PI_SKIP_VERSION_CHECK=1 \
    PI_TELEMETRY=0 \
    PI_CODING_AGENT_DIR=/agent-state/pi-agent \
    NPM_CONFIG_CACHE=/tmp/.npm \
    NPM_CONFIG_UPDATE_NOTIFIER=false

USER agent
WORKDIR /workspace
CMD ["sleep", "infinity"]
